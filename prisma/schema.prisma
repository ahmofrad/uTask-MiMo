generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  suspended
  invited
  ldapGroupRemoved
}

enum Locale {
  fa_IR
  en_US
}

enum Theme {
  light
  dark
  system
  midnight
  solarized
  high_contrast
  nord
}

enum Density {
  compact
  comfortable
  spacious
}

enum RoleType {
  owner
  admin
  manager
  member
  guest
}

enum RateCardScope {
  user
  role
}

enum TimesheetStatus {
  open
  submitted
  approved
  rejected
  reopened
}

enum RoleScope {
  global
  project
}

enum DepartmentSource {
  manual
  ldap
}

enum DepartmentManagerSource {
  ad
  manual
}

/// How a group's membership is populated.
/// `ldap` groups are synced from Active Directory (and may carry extra manual
/// members); `manual` groups are created in-app and filled by hand.
enum GroupSource {
  ldap
  manual
}

enum ProjectDepartmentLinkRequestStatus {
  pending
  approved
  rejected
  cancelled
  revoked
}

enum ProjectVisibility {
  private
  department
  org
}

enum ProjectStatus {
  active
  archived
}

enum RagStatus {
  GREEN
  AMBER
  RED
}

enum ProjectMemberRole {
  lead
  contributor
  viewer
}

enum ProjectMemberDisableReason {
  ldap
}

enum CustomFieldType {
  text
  number
  date
  select
  multi_select
  user
  checkbox
  url
}

enum TaskStatus {
  open
  in_progress
  pending_approval
  done
  cancelled
}

enum TaskPriority {
  low
  med
  high
  urgent
}

enum AuthProvider {
  local
  ldap
  saml
}

enum NotificationType {
  assigned
  mentioned
  due_soon
  commented
  status_changed
  unblocked
  department_link_request
  group_role_granted
  group_role_revoked
}

enum DependencyType {
  FINISH_TO_START
  START_TO_START
  FINISH_TO_FINISH
  RELATES_TO
}

enum LagUnit {
  DAY
  HOUR
}

enum AuditAction {
  created
  updated
  deleted
  viewed
  exported
  login_success
  login_failed
  logout
  force_logout
  identity_linked
  user_jit_created
  password_changed
  password_reset_requested
  invite_sent
  invite_accepted
  saml_config_changed
  ldap_config_changed
  ldap_source_created
  ldap_source_updated
  ldap_source_deleted
  ldap_source_tested
  ldap_group_added
  ldap_group_removed
  ldap_sync
  api_token_created
  api_token_revoked
  webhook_created
  webhook_updated
  webhook_deleted
  webhook_tested
  webhook_delivery_replayed
  task_created
  task_updated
  task_deleted
  task_group_assigned
  task_reordered
  task_moved
  task_dependency_created
  task_dependency_deleted
  task_approved
  task_rejected
  task_recurrence_spawned
  comment_created
  comment_updated
  comment_deleted
  project_created
  project_updated
  project_archived
  project_health_updated
  project_department_link_requested
  project_department_link_approved
  project_department_link_rejected
  project_department_link_cancelled
  custom_field_created
  custom_field_updated
  custom_field_archived
  project_member_added
  project_member_removed
  watcher_added
  watcher_removed
  settings_updated
  holidays_imported
  user_updated
  user_suspended
  user_unsuspended
  department_created
  department_updated
  department_deleted
  group_created
  group_updated
  group_deleted
  group_member_added
  group_member_removed
  group_grant_created
  group_grant_revoked
  session_revoked
  mail_test_sent
  timesheet_period_created
  timesheet_period_submitted
  timesheet_period_approved
  timesheet_period_rejected
  timesheet_period_reopened
  timesheet_entry_created
  rate_card_created
  rate_card_updated
  rate_card_deleted
}

enum SettingsScope {
  install
  user
  org
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique @db.Citext
  passwordHash  String?    @db.VarChar(255)
  displayName   String     @db.VarChar(255)
  avatarUrl     String?
  locale        Locale     @default(fa_IR)
  accentColor   String     @default("#2563eb") @db.VarChar(7)
  theme         Theme      @default(system)
  density       Density    @default(comfortable)
  status        UserStatus @default(active)
  ldapGroup     String?    @db.VarChar(255)
  ldapGroupId   String?    @db.Uuid
  lastLoginAt   DateTime?  @db.Timestamptz
  emailVerified DateTime?  @db.Timestamptz
  image         String?
  createdAt     DateTime   @default(now()) @db.Timestamptz
  updatedAt     DateTime   @updatedAt @db.Timestamptz

  authIdentities                        AuthIdentity[]
  accounts                              Account[]
  sessions                              Session[]
  roles                                 Role[]
  ownedProjects                         Project[]                      @relation("ProjectOwner")
  projectMembers                        ProjectMember[]                @relation("ProjectMemberUser")
  projectMemberAdded                    ProjectMember[]                @relation("ProjectMemberAddedBy")
  assignedTasks                         TaskAssignee[]                 @relation("UserAssignedTasks")
  reportedTasks                         Task[]                         @relation("TaskReporter")
  createdTasks                          Task[]                         @relation("TaskCreator")
  attachments                           Attachment[]
  comments                              Comment[]
  watchers                              Watcher[]
  notifications                         Notification[]
  auditLogs                             AuditLog[]
  apiTokens                             ApiToken[]
  webhooks                              Webhook[]
  projectTemplates                      ProjectTemplate[]
  ldapMemberships                       LdapGroupMembership[]
  groupGrantsGranted                    ProjectGroupGrant[]            @relation("ProjectGroupGrantGrantedBy")
  managedDepartments                    Department[]                   @relation("DepartmentManager")
  projectDepartmentLinkRequestsMade     ProjectDepartmentLinkRequest[] @relation("ProjectDepartmentLinkRequestRequester")
  projectDepartmentLinkRequestsReviewed ProjectDepartmentLinkRequest[] @relation("ProjectDepartmentLinkRequestReviewer")
  rateCards                             RateCard[]                     @relation("RateCardUser")
  timesheetPeriods                      TimesheetPeriod[]              @relation("TimesheetPeriodOwner")
  timeEntries                           TimeEntry[]                    @relation("TimeEntryUser")

  @@map("User")
}

model AuthIdentity {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @db.Uuid
  provider        AuthProvider
  providerSubject String       @db.VarChar(512)
  providerIssuer  String?      @db.VarChar(512)
  linkedAt        DateTime     @default(now()) @db.Timestamptz
  lastUsedAt      DateTime?    @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@map("AuthIdentity")
}

model Role {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      RoleType
  scopeType RoleScope @default(global)
  scopeId   String?   @db.Uuid
  grantedBy String?   @db.Uuid
  grantedAt DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, scopeType, scopeId])
  @@map("Role")
}

model Department {
  id              String                   @id @default(uuid()) @db.Uuid
  name            String                   @db.VarChar(255)
  parentId        String?                  @db.Uuid
  managerUserId   String?                  @db.Uuid
  managerSource   DepartmentManagerSource?
  source          DepartmentSource         @default(manual)
  ldapSyncGroupId String?                  @unique @db.Uuid
  deletedAt       DateTime?                @db.Timestamptz
  createdAt       DateTime                 @default(now()) @db.Timestamptz
  updatedAt       DateTime                 @updatedAt @db.Timestamptz

  parent                 Department?                    @relation("DepartmentTree", fields: [parentId], references: [id])
  children               Department[]                   @relation("DepartmentTree")
  manager                User?                          @relation("DepartmentManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  ldapSyncGroup          LdapSyncGroup?                 @relation("LdapSyncGroupDepartment", fields: [ldapSyncGroupId], references: [id], onDelete: SetNull)
  ownedGroups            LdapSyncGroup[]                @relation("GroupOwnerDepartment")
  projects               Project[]
  projectLinks           ProjectDepartment[]
  departmentLinkRequests ProjectDepartmentLinkRequest[]
  timesheetPeriods       TimesheetPeriod[]

  @@map("Department")
}

model Project {
  id              String            @id @default(uuid()) @db.Uuid
  name            String            @db.VarChar(255)
  description     String?           @db.Text
  color           String            @default("#2563eb") @db.VarChar(7)
  ownerId         String            @db.Uuid
  departmentId    String?           @db.Uuid
  scheduleVersion Int               @default(0)
  visibility      ProjectVisibility @default(private)
  status          ProjectStatus     @default(active)
  ragStatus       RagStatus         @default(GREEN)
  ragReason       String?           @db.VarChar(500)
  healthUpdatedAt DateTime?         @db.Timestamptz
  archivedAt      DateTime?         @db.Timestamptz
  createdAt       DateTime          @default(now()) @db.Timestamptz
  updatedAt       DateTime          @updatedAt @db.Timestamptz

  owner                  User                           @relation("ProjectOwner", fields: [ownerId], references: [id])
  department             Department?                    @relation(fields: [departmentId], references: [id])
  departmentLinks        ProjectDepartment[]
  departmentLinkRequests ProjectDepartmentLinkRequest[]
  members                ProjectMember[]
  groupGrants            ProjectGroupGrant[]
  customFields           CustomField[]
  tasks                  Task[]
  tags                   Tag[]
  timeEntries            TimeEntry[]

  @@index([ownerId])
  @@index([departmentId])
  @@map("Project")
}

model ProjectDepartment {
  projectId    String   @db.Uuid
  departmentId String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([projectId, departmentId])
  @@index([departmentId, projectId])
  @@map("ProjectDepartment")
}

model ProjectDepartmentLinkRequest {
  id            String                             @id @default(uuid()) @db.Uuid
  projectId     String                             @db.Uuid
  departmentId  String                             @db.Uuid
  requestedById String                             @db.Uuid
  reviewedById  String?                            @db.Uuid
  status        ProjectDepartmentLinkRequestStatus @default(pending)
  createdAt     DateTime                           @default(now()) @db.Timestamptz
  reviewedAt    DateTime?                          @db.Timestamptz

  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  department  Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  requestedBy User       @relation("ProjectDepartmentLinkRequestRequester", fields: [requestedById], references: [id])
  reviewedBy  User?      @relation("ProjectDepartmentLinkRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([projectId, departmentId, status])
  @@index([departmentId, status])
  @@map("ProjectDepartmentLinkRequest")
}

model ProjectMember {
  projectId      String                      @db.Uuid
  userId         String                      @db.Uuid
  projectRole    ProjectMemberRole           @default(contributor)
  addedAt        DateTime                    @default(now()) @db.Timestamptz
  addedBy        String                      @db.Uuid
  disabledAt     DateTime?                   @db.Timestamptz
  disabledReason ProjectMemberDisableReason?

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User    @relation("ProjectMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  addedByUser User    @relation("ProjectMemberAddedBy", fields: [addedBy], references: [id])

  @@id([projectId, userId])
  @@map("ProjectMember")
}

/// A role granted to a whole group on a project. Access is computed live from
/// these rows (see RBAC ticket #4) — membership changes propagate immediately.
model ProjectGroupGrant {
  projectId String            @db.Uuid
  groupId   String            @db.Uuid
  role      ProjectMemberRole @default(contributor)
  grantedBy String            @db.Uuid
  grantedAt DateTime          @default(now()) @db.Timestamptz

  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  group         LdapSyncGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  grantedByUser User          @relation("ProjectGroupGrantGrantedBy", fields: [grantedBy], references: [id])

  @@id([projectId, groupId])
  @@index([groupId, projectId])
  @@map("ProjectGroupGrant")
}

model CustomField {
  id         String          @id @default(uuid()) @db.Uuid
  projectId  String          @db.Uuid
  name       String          @db.VarChar(255)
  key        String          @db.VarChar(255)
  type       CustomFieldType
  required   Boolean         @default(false)
  orderIndex Int             @default(0)
  configJson Json?
  createdAt  DateTime        @default(now()) @db.Timestamptz
  updatedAt  DateTime        @updatedAt @db.Timestamptz
  archivedAt DateTime?       @db.Timestamptz

  project Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  values  CustomFieldValue[]

  @@unique([projectId, key])
  @@index([projectId, orderIndex])
  @@map("CustomField")
}

model CustomFieldValue {
  id            String    @id @default(uuid()) @db.Uuid
  taskId        String    @db.Uuid
  customFieldId String    @db.Uuid
  valueText     String?   @db.Text
  valueNumber   Decimal?  @db.Decimal(20, 4)
  valueDate     DateTime? @db.Timestamptz
  valueBool     Boolean?
  valueJson     Json?
  createdAt     DateTime  @default(now()) @db.Timestamptz
  updatedAt     DateTime  @updatedAt @db.Timestamptz

  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  customField CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@unique([taskId, customFieldId])
  @@index([customFieldId, valueText])
  @@index([customFieldId, valueNumber])
  @@index([customFieldId, valueDate])
  @@map("CustomFieldValue")
}

model Task {
  id                 String       @id @default(uuid()) @db.Uuid
  projectId          String       @db.Uuid
  parentTaskId       String?      @db.Uuid
  title              String       @db.VarChar(500)
  description        String?      @db.Text
  status             TaskStatus   @default(open)
  priority           TaskPriority @default(med)
  startDate          DateTime?    @db.Timestamptz
  endDate            DateTime?    @db.Timestamptz
  dueDate            DateTime?    @db.Timestamptz
  recurrenceRule     String?      @db.VarChar(500)
  recurrenceParentId String?      @db.Uuid
  reporterId         String?      @db.Uuid
  createdById        String       @db.Uuid
  assigneeGroupId    String?      @db.Uuid
  estimatedHours     Decimal?     @db.Decimal(10, 2)
  spentHours         Decimal?     @db.Decimal(10, 2)
  orderIndex         Decimal?     @db.Decimal(30, 10)
  progress           Int          @default(0)
  isMilestone        Boolean      @default(false)
  milestoneKind      String?
  requiresApproval   Boolean      @default(false)
  approverId         String?      @db.Uuid
  approvalNote       String?      @db.Text
  completedAt        DateTime?    @db.Timestamptz
  deletedAt          DateTime?    @db.Timestamptz
  createdAt          DateTime     @default(now()) @db.Timestamptz
  updatedAt          DateTime     @updatedAt @db.Timestamptz

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentTask    Task?          @relation("Subtask", fields: [parentTaskId], references: [id])
  subtasks      Task[]         @relation("Subtask")
  assignees     TaskAssignee[] @relation("TaskAssignees")
  assigneeGroup LdapSyncGroup? @relation("TaskAssigneeGroup", fields: [assigneeGroupId], references: [id], onDelete: SetNull)
  reporter      User?          @relation("TaskReporter", fields: [reporterId], references: [id])
  createdBy     User           @relation("TaskCreator", fields: [createdById], references: [id])

  customFieldValues CustomFieldValue[]
  comments          Comment[]
  attachments       Attachment[]
  watchers          Watcher[]
  tags              TaskTag[]

  dependencies TaskDependency[] @relation("DependencyDependent")
  dependsOn    TaskDependency[] @relation("DependencyPredecessor")
  timeEntries  TimeEntry[]      @relation("TimeEntryTask")

  @@index([projectId, status, dueDate])
  @@index([projectId, orderIndex])
  @@index([parentTaskId])
  @@index([reporterId])
  @@index([createdById])
  @@index([dueDate])
  @@index([deletedAt])
  @@index([assigneeGroupId])
  @@map("Task")
}

model TaskAssignee {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz

  task Task @relation("TaskAssignees", fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation("UserAssignedTasks", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
  @@index([taskId])
  @@map("TaskAssignee")
}

model TaskDependency {
  id          String         @id @default(uuid()) @db.Uuid
  taskId      String         @db.Uuid
  dependsOnId String         @db.Uuid
  type        DependencyType @default(FINISH_TO_START)
  lag         Int            @default(0)
  lagUnit     LagUnit        @default(DAY)
  teamId      String?
  createdBy   String         @db.Uuid
  createdAt   DateTime       @default(now()) @db.Timestamptz
  deletedAt   DateTime?      @db.Timestamptz

  task      Task @relation("DependencyDependent", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("DependencyPredecessor", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId, type])
  @@index([dependsOnId])
  @@index([teamId])
  @@index([deletedAt])
  @@map("TaskDependency")
}

model InstanceSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz
  updatedBy String?  @db.Uuid

  @@map("InstanceSetting")
}

model Tag {
  id        String  @id @default(uuid()) @db.Uuid
  name      String  @db.VarChar(100)
  color     String  @default("#94a3b8") @db.VarChar(7)
  projectId String? @db.Uuid

  project Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   TaskTag[]

  @@unique([name, projectId])
  @@map("Tag")
}

model TaskTag {
  taskId String @db.Uuid
  tagId  String @db.Uuid

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("TaskTag")
}

model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  taskId       String   @db.Uuid
  filename     String   @db.VarChar(500)
  mimeType     String   @db.VarChar(255)
  sizeBytes    Int
  storageKey   String   @db.VarChar(1000)
  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([taskId])
  @@map("Attachment")
}

model Comment {
  id              String    @id @default(uuid()) @db.Uuid
  taskId          String    @db.Uuid
  authorId        String    @db.Uuid
  parentCommentId String?   @db.Uuid
  bodyMarkdown    String    @db.Text
  editedAt        DateTime? @db.Timestamptz
  deletedAt       DateTime? @db.Timestamptz
  createdAt       DateTime  @default(now()) @db.Timestamptz

  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author        User      @relation(fields: [authorId], references: [id])
  parentComment Comment?  @relation("CommentReply", fields: [parentCommentId], references: [id])
  replies       Comment[] @relation("CommentReply")

  @@index([taskId, createdAt])
  @@map("Comment")
}

model Watcher {
  taskId  String   @db.Uuid
  userId  String   @db.Uuid
  addedAt DateTime @default(now()) @db.Timestamptz

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@map("Watcher")
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  type        NotificationType
  payloadJson Json?
  taskId      String?          @db.Uuid
  readAt      DateTime?        @db.Timestamptz
  createdAt   DateTime         @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("Notification")
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  actorUserId String?     @db.Uuid
  actorIp     String?     @db.VarChar(45)
  action      AuditAction
  entityType  String      @db.VarChar(100)
  // Domain-specific entity identifier (UUID for row entities, or a stable
  // key for non-row entities like settings sections "sso"/"smtp"/"storage").
  entityId    String      @db.VarChar(512)
  beforeJson  Json?
  afterJson   Json?
  occurredAt  DateTime    @default(now()) @db.Timestamptz
  requestId   String?     @db.VarChar(100)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([occurredAt])
  @@map("AuditLog")
}

model ApiToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  name        String    @db.VarChar(255)
  hashedToken String    @unique @db.VarChar(64)
  prefix      String    @db.VarChar(12)
  scopes      String[]
  expiresAt   DateTime? @db.Timestamptz
  lastUsedAt  DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
  revokedAt   DateTime? @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([hashedToken])
  @@index([userId])
  @@map("ApiToken")
}

model Webhook {
  id             String    @id @default(uuid()) @db.Uuid
  name           String    @db.VarChar(255)
  url            String    @db.VarChar(2000)
  secret         String    @db.VarChar(500)
  events         String[]
  active         Boolean   @default(true)
  description    String?   @db.Text
  createdById    String    @db.Uuid
  lastDeliveryAt DateTime? @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz
  createdAt      DateTime  @default(now()) @db.Timestamptz
  updatedAt      DateTime  @updatedAt @db.Timestamptz

  createdBy  User              @relation(fields: [createdById], references: [id])
  deliveries WebhookDelivery[]

  @@index([createdById])
  @@index([deletedAt])
  @@map("Webhook")
}

model ProjectTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(255)
  description  String?  @db.Text
  color        String   @default("#2563eb") @db.VarChar(7)
  templateJson Json     @db.Json
  createdById  String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([createdById])
  @@map("ProjectTemplate")
}

model WebhookDelivery {
  id              String    @id @default(uuid()) @db.Uuid
  webhookId       String    @db.Uuid
  eventType       String    @db.VarChar(100)
  eventId         String    @db.Uuid
  attemptNumber   Int       @default(1)
  requestPayload  Json?
  responseStatus  Int?
  responseBody    String?   @db.Text
  responseHeaders Json?
  durationMs      Int?
  error           String?   @db.Text
  scheduledAt     DateTime  @default(now()) @db.Timestamptz
  deliveredAt     DateTime? @db.Timestamptz
  nextRetryAt     DateTime? @db.Timestamptz

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, scheduledAt])
  @@index([eventId])
  @@map("WebhookDelivery")
}

model Settings {
  id        String        @id @default(uuid()) @db.Uuid
  scope     SettingsScope
  scopeId   String?       @db.Uuid
  key       String        @db.VarChar(255)
  valueJson Json?

  @@unique([scope, scopeId, key])
  @@map("Settings")
}

/// A configured Active Directory (LDAP) directory. An instance can register
/// several sources, each with its own connection, bind credentials, UPN
/// suffix, search base, and sync schedule; AD-synced groups point at the
/// source they came from via `LdapSyncGroup.sourceId`.
model LdapSource {
  id                String    @id @default(uuid()) @db.Uuid
  name              String    @db.VarChar(255)
  enabled           Boolean   @default(false)
  url               String    @db.VarChar(512)
  // Service account UPN used to bind and search the directory.
  bindUpn           String    @db.VarChar(255)
  // Encrypted at rest (iv:ciphertext:tag, AES-256-GCM via lib/crypto).
  bindPassword      String    @db.VarChar(512)
  // Optional UPN suffix (e.g. "@corp.local") appended when a user logs in
  // with only a samaccountname; end users may also log in with a full UPN.
  upnSuffix         String?   @db.VarChar(255)
  // Base DN for directory searches; falls back to the UPN-derived domain DN.
  searchBase        String?   @db.VarChar(512)
  emailAttribute    String    @default("mail") @db.VarChar(64)
  nameAttribute     String    @default("cn") @db.VarChar(64)
  defaultRole       String    @default("member") @db.VarChar(64)
  // Hours between automatic group syncs (per source).
  syncIntervalHours Int       @default(12)
  tlsCaCert         String?   @db.Text
  lastSyncedAt      DateTime? @db.Timestamptz
  lastSyncError     String?   @db.Text
  deletedAt         DateTime? @db.Timestamptz
  createdAt         DateTime  @default(now()) @db.Timestamptz
  updatedAt         DateTime  @updatedAt @db.Timestamptz

  groups LdapSyncGroup[]

  @@index([deletedAt])
  @@map("LdapSource")
}

model LdapSyncGroup {
  id                String      @id @default(uuid()) @db.Uuid
  name              String      @db.VarChar(255)
  dn                String?     @unique @db.VarChar(512)
  objectGuid        String?     @unique @db.VarChar(128)
  managerDn         String?     @db.VarChar(512)
  source            GroupSource @default(ldap)
  // Directory this AD-synced group came from; null for manual groups.
  sourceId          String?     @db.Uuid
  ownerDepartmentId String?     @db.Uuid
  lastSyncedAt      DateTime?   @db.Timestamptz
  deletedAt         DateTime?   @db.Timestamptz
  createdAt         DateTime    @default(now()) @db.Timestamptz

  ldapSource      LdapSource?           @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  department      Department?           @relation("LdapSyncGroupDepartment")
  ownerDepartment Department?           @relation("GroupOwnerDepartment", fields: [ownerDepartmentId], references: [id], onDelete: SetNull)
  memberships     LdapGroupMembership[]
  assignedTasks   Task[]                @relation("TaskAssigneeGroup")
  projectGrants   ProjectGroupGrant[]

  @@index([sourceId])
  @@index([ownerDepartmentId])
  @@index([deletedAt])
  @@map("LdapSyncGroup")
}

model LdapGroupMembership {
  userId          String    @db.Uuid
  ldapSyncGroupId String    @db.Uuid
  sourceMemberDn  String?   @db.VarChar(512)
  lastSeenAt      DateTime? @db.Timestamptz
  createdAt       DateTime  @default(now()) @db.Timestamptz

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  group LdapSyncGroup @relation(fields: [ldapSyncGroupId], references: [id], onDelete: Cascade)

  @@id([userId, ldapSyncGroupId])
  @@index([ldapSyncGroupId, lastSeenAt])
  @@map("LdapGroupMembership")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String  @db.VarChar(50)
  provider          String  @db.VarChar(100)
  providerAccountId String  @db.VarChar(255)
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String? @db.VarChar(50)
  scope             String? @db.VarChar(255)
  id_token          String? @db.Text
  session_state     String? @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("Account")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @db.VarChar(255)
  userId       String   @db.Uuid
  expires      DateTime @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("Session")
}

model VerificationToken {
  identifier String   @db.VarChar(255)
  token      String   @unique @db.VarChar(255)
  expires    DateTime @db.Timestamptz

  @@unique([identifier, token])
  @@map("VerificationToken")
}

/// A cost/bill rate for a specific user or for everyone holding a global role.
/// The cost rate is snapshotted onto TimeEntry at log time so historical
/// actuals never drift when a rate changes later.
model RateCard {
  id            String        @id @default(uuid()) @db.Uuid
  scope         RateCardScope
  userId        String?       @db.Uuid
  roleType      RoleType?
  costRateMinor Int
  billRateMinor Int?
  currency      String        @default("USD") @db.VarChar(3)
  effectiveFrom DateTime      @db.Timestamptz
  effectiveTo   DateTime?     @db.Timestamptz
  createdAt     DateTime      @default(now()) @db.Timestamptz
  updatedAt     DateTime      @updatedAt @db.Timestamptz

  user User? @relation("RateCardUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([scope, userId])
  @@index([scope, roleType])
  @@index([effectiveFrom])
  @@map("RateCard")
}

model TimesheetPeriod {
  id           String          @id @default(uuid()) @db.Uuid
  departmentId String          @db.Uuid
  ownerId      String          @db.Uuid
  periodStart  DateTime        @db.Timestamptz
  periodEnd    DateTime        @db.Timestamptz
  status       TimesheetStatus @default(open)
  createdAt    DateTime        @default(now()) @db.Timestamptz
  updatedAt    DateTime        @updatedAt @db.Timestamptz

  department Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  owner      User        @relation("TimesheetPeriodOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  entries    TimeEntry[]

  @@index([departmentId, periodStart])
  @@index([ownerId])
  @@index([status])
  @@map("TimesheetPeriod")
}

model TimeEntry {
  id                    String   @id @default(uuid()) @db.Uuid
  periodId              String?  @db.Uuid
  projectId             String   @db.Uuid
  taskId                String?  @db.Uuid
  userId                String   @db.Uuid
  minutes               Int
  billable              Boolean  @default(true)
  costRateMinorSnapshot Int
  currencySnapshot      String   @default("USD") @db.VarChar(3)
  createdAt             DateTime @default(now()) @db.Timestamptz

  period  TimesheetPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?            @relation("TimeEntryTask", fields: [taskId], references: [id], onDelete: SetNull)
  user    User             @relation("TimeEntryUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([periodId])
  @@index([projectId, userId])
  @@index([userId, createdAt])
  @@map("TimeEntry")
}
