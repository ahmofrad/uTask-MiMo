{
  "title": "Webhook Delivery Health",
  "tags": ["taskapp", "webhook", "delivery", "production"],
  "schemaVersion": 37,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Webhook Delivery Rate by Status",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(taskapp_webhook_deliveries_total{status=\"success\"}[5m])",
          "legendFormat": "success",
          "datasource": "Prometheus"
        },
        {
          "expr": "rate(taskapp_webhook_deliveries_total{status=\"failed\"}[5m])",
          "legendFormat": "failed",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rps",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Webhook Delivery Latency p50 / p95",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(taskapp_webhook_delivery_duration_seconds_bucket[5m]))",
          "legendFormat": "p50",
          "datasource": "Prometheus"
        },
        {
          "expr": "histogram_quantile(0.95, rate(taskapp_webhook_delivery_duration_seconds_bucket[5m]))",
          "legendFormat": "p95",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Failed Webhooks by Target URL",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "rate(taskapp_webhook_deliveries_total{status=\"failed\"}[5m])",
          "legendFormat": "{{target_url}}",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rps",
          "color": { "mode": "palette-classic" }
        }
      }
    }
  ]
}
