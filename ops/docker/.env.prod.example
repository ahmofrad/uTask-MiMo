# ──────────────────────────────────────────────
# TaskApp — Production Environment Variables
# Copy this file to .env.prod and fill in values.
# chmod 600 .env.prod && owned by deploy user
# NEVER commit .env.prod to version control.
# ──────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────────────────────
APP_VERSION=1.0.0
SITE_NAME="TaskApp"
DEFAULT_LOCALE=en-US
DEFAULT_ACCENT=#1d4ed8

# ── Database ───────────────────────────────────────────────────────────────
# Postgres connection via PgBouncer
DATABASE_URL=postgresql://taskapp:${DB_PASSWORD}@pgbouncer:6432/taskapp
DB_PASSWORD=<generate-a-32-char-random-string>

# ── Auth ────────────────────────────────────────────────────────────────────
# Used for JWT signing and session encryption.  Generate with: openssl rand -hex 64
AUTH_SECRET=<generate-a-64-char-random-hex-string>
# Public origin used for Auth.js callbacks and Socket.IO CORS/cookie handling.
AUTH_URL=https://taskapp.corp.example.com

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
TRUST_PROXY=true
RATE_LIMIT_FAIL_CLOSED=true

# ── Object Storage (S3-compatible, e.g. MinIO) ─────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=<generate-20-char-access-key>
S3_SECRET_KEY=<generate-40-char-secret-key>
S3_REGION=us-east-1
S3_BUCKET=taskapp

# ── SMTP (Email) ───────────────────────────────────────────────────────────
SMTP_HOST=smtp.corp.example.com
SMTP_PORT=587
SMTP_USER=taskapp@corp.example.com
SMTP_PASSWORD=<smtp-password>
SMTP_FROM="TaskApp <taskapp@corp.example.com>"

# ── LDAP (optional — omit if not used) ─────────────────────────────────────
LDAP_URL=ldaps://ldap.corp.example.com:636
LDAP_BIND_DN=cn=svc-taskapp,ou=service-accounts,dc=corp,dc=example,dc=com
LDAP_BIND_PASSWORD=<ldap-bind-password>
LDAP_SEARCH_BASE=ou=people,dc=corp,dc=example,dc=com
LDAP_DEFAULT_ROLE=member

# ── SAML (optional — omit if not used) ─────────────────────────────────────
SAML_ENTITY_ID=https://taskapp.corp.example.com
SAML_IDP_METADATA_URL=https://login.microsoftonline.com/<tenant-id>/federationmetadata/2007-06/federationmetadata.xml
SAML_IDP_CERTIFICATE=<base64-idp-certificate>
SAML_PRIVATE_KEY=<private-key-for-saml-assertion-encryption>
SAML_CALLBACK_URL=https://taskapp.corp.example.com/api/v1/auth/saml/callback

# ── Webhook Encryption Key ─────────────────────────────────────────────────
# AES-256-GCM key for encrypting webhook signing secrets at rest.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET_ENCRYPTION_KEY=<generate-a-64-char-random-hex-string>

# ── Backups ────────────────────────────────────────────────────────────────
BACKUP_SCHEDULE="0 2 * * *"   # cron: 02:00 daily
BACKUP_DESTINATION=s3          # s3 | local | scp
BACKUP_S3_BUCKET=corp-backups
BACKUP_S3_ENDPOINT=https://s3.corp.example.com
BACKUP_RETENTION_DAYS=30

# ── Observability ──────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://grafana-tempo:4318
OTEL_SERVICE_NAME=taskapp

# ── Node ───────────────────────────────────────────────────────────────────
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=2048

# ── Feature Flags ──────────────────────────────────────────────────────────
# MAINTENANCE_MODE=false
# DISABLE_WEBHOOKS=false
