{
  "name": "taskapp",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted enterprise task management platform",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "test:visual": "playwright test --grep @visual",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prisma": "prisma",
    "prisma:studio": "prisma studio",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:seed": "npm run prisma:seed",
    "docker:up": "docker compose -f ops/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f ops/docker/docker-compose.yml down",
    "i18n:extract": "i18next-parser 'src/**/*.{ts,tsx}' --output src/messages/$LOCALE.json",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "design:check": "tsx scripts/design-check.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/s3-request-presigner": "^3.1079.0",
    "@base-ui/react": "^1.6.0",
    "@node-saml/node-saml": "^5.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@prisma/client": "^5.22.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.79.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-jalali": "^4.4.0-0",
    "ioredis": "^5.11.1",
    "isomorphic-dompurify": "^3.18.0",
    "ldapts": "^8.1.8",
    "lucide-react": "^1.23.0",
    "marked": "^18.0.5",
    "next": "^14.2.0",
    "next-auth": "^5.0.0-beta.31",
    "next-intl": "^4.13.1",
    "nodemailer": "^7.0.13",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^18.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.3.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "postcss": "^8.4.0",
    "prettier": "^3.9.4",
    "prisma": "^5.22.0",
    "shadcn": "^4.13.0",
    "tailwindcss": "^3.4.0",
    "testcontainers": "^12.0.4",
    "tsx": "^4.23.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
