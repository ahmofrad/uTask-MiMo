# ─── Database ───
# Keep this in sync with ops/docker/docker-compose.yml.
DATABASE_URL=postgresql://taskapp:taskapp@localhost:5432/taskapp

# ─── Redis ───
REDIS_URL=redis://localhost:6379

# ─── Auth ───
AUTH_SECRET=change-me-to-a-random-64-char-string
AUTH_URL=http://localhost:3000

# ─── S3 / MinIO ───
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=taskapp

# ─── SMTP ───
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=taskapp@local.dev

# ─── LDAP / SAML (SSO) ───
# NOTE: LDAP and SAML are configured through the admin **SSO** settings page and
# stored in the `Settings` table (scope=install) — NOT via environment variables.
# The legacy LDAP_* / SAML_* vars below are NOT consumed by the application.
# LDAP config fields: url, bindUpn, bindPassword, upnSuffix, emailAttribute,
#   nameAttribute, defaultRole, syncIntervalHours, tlsCaCert
# SAML config fields: entityId, acsUrl, idpMetadataUrl, idpEntityId, idpSsoUrl,
#   idpCertificate, attributeMap, defaultRole, nameIdFormat
# LDAP_URL=ldap://localhost:389
# LDAP_BIND_DN=cn=admin,dc=example,dc=org
# LDAP_BIND_PASSWORD=admin
# LDAP_SEARCH_BASE=dc=example,dc=org
# LDAP_SEARCH_FILTER=(&(objectClass=person)(uid={{username}}))
# LDAP_USERNAME_ATTRIBUTE=uid
# LDAP_EMAIL_ATTRIBUTE=mail
# LDAP_NAME_ATTRIBUTE=cn
# LDAP_DEFAULT_ROLE=member
# SAML_ENTITY_ID=http://localhost:3000/saml/metadata
# SAML_ACS_URL=http://localhost:3000/api/v1/auth/saml/callback

# ─── Webhook ───
WEBHOOK_SECRET_ENCRYPTION_KEY=change-me-to-a-random-32-char-string

# ─── Rate limiting ───
# RATE_LIMIT_BACKEND=redis        # redis | memory
# RATE_LIMIT_FAIL_CLOSED=false    # reject requests when Redis is down
# RATE_LIMIT_DISABLED=false       # bypass all rate limits (used by the e2e test server)

# ─── App ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=fa-IR

# ─── Monitoring ───
OTEL_SERVICE_NAME=taskapp
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
